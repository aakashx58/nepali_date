{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "sourceMap": false,
        "declarationMap": false,
        "removeComments": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist", "tests"]
}
